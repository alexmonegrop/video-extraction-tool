# HuggingFace token (required for pyannote speaker diarization)
# Get one at https://huggingface.co/settings/tokens
# You must also accept the licenses for all three gated models:
#   - pyannote/speaker-diarization-3.1
#   - pyannote/segmentation-3.0
#   - pyannote/speaker-diarization-community-1
HF_TOKEN=hf_your_token_here

# Anthropic API key (only needed for headless src/analyze_visual.py)
# Not required for interactive use with Claude Code's built-in vision.
ANTHROPIC_API_KEY=sk-ant-your_key_here
